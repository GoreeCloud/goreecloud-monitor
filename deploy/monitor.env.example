# GoreeCloud Monitor protected production application configuration.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_PROTECTED_RANDOM_VALUE
DJANGO_ALLOWED_HOSTS=monitor.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://monitor.example.invalid
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=0
WARDVEIL_LOG_LEVEL=INFO
MONITOR_ACCESS_LOG_LEVEL=INFO

MONITOR_MAX_CONCURRENCY=10
MONITOR_MAX_RESPONSE_BYTES=1048576
MONITOR_CHECK_RETENTION_DAYS=30
MONITOR_JOB_EVENT_RETENTION_DAYS=90
# Automatic history pruning cadence. Bounded to 60–86400 seconds.
MONITOR_HISTORY_PRUNE_INTERVAL_SECONDS=3600
MONITOR_POLL_SECONDS=1
MONITOR_ALLOW_PUBLIC_TARGETS=true
MONITOR_ALLOWED_NETWORKS=127.0.0.0/8,::1/128
# Must remain false for production acceptance; URL-embedded heartbeat secrets are legacy only.
MONITOR_ALLOW_LEGACY_PATH_HEARTBEATS=false
# Per-monitor scheduled-job ingestion limit. Idempotent replays do not consume additional slots.
MONITOR_JOB_SIGNAL_MAX_PER_MINUTE=5

MANAGER_API_TOKEN=

# GoreeCloud Notify is the only supported Monitor notification publisher after ntfy retirement.
# Keep it disabled until Notify is production-accepted; final Monitor target acceptance requires it enabled.
# Provision both values only in protected runtime configuration; never commit a token.
MONITOR_NOTIFY_ENABLED=false
GOREECLOUD_NOTIFY_BASE_URL=
GOREECLOUD_NOTIFY_TOKEN=
MONITOR_NOTIFY_MAX_ATTEMPTS=3
MONITOR_NOTIFY_RETRY_BACKOFF_SECONDS=0.25
MONITOR_NOTIFY_TIMEOUT_SECONDS=10
# Delivered outbox metadata is retained only for this bounded period; pending records are never pruned by retention.
MONITOR_NOTIFICATION_OUTBOX_RETENTION_DAYS=30
