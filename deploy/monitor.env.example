# GoreeCloud Monitor application configuration. This file becomes protected
# infrastructure configuration when copied to monitor.env in production.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_PROTECTED_RANDOM_VALUE
DJANGO_ALLOWED_HOSTS=monitor.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://monitor.example.invalid
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=0

MONITOR_MAX_CONCURRENCY=10
MONITOR_MAX_RESPONSE_BYTES=1048576
MONITOR_CHECK_RETENTION_DAYS=30
MONITOR_POLL_SECONDS=1
MONITOR_ALLOW_PUBLIC_TARGETS=true
# Replace with only the exact private/reserved networks required by approved targets.
MONITOR_ALLOWED_NETWORKS=127.0.0.0/8,::1/128

# Read-only GoreeCloud Manager integration. Leave blank until approved.
MANAGER_API_TOKEN=

# ntfy transition publishing. Leave all three blank until the dedicated write-only
# Monitor identity and ACL have been created and validated.
NTFY_BASE_URL=
NTFY_TOPIC=
NTFY_TOKEN=
