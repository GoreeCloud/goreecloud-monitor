# Compose interpolation only. Copy to the authoritative production stack as .env
# and replace every placeholder before deployment.

# GoreeCloud Monitor must use a unique traceable locally built image tag or an
# approved registry digest. Do not use latest.
GOREECLOUD_MONITOR_IMAGE=goreecloud-monitor:git-REPLACE_WITH_COMMIT

# Stateful production images require an exact tag and digest under GoreeCloud policy.
POSTGRES_IMAGE=postgres:17.10-bookworm@sha256:REPLACE_WITH_VERIFIED_DIGEST

# Protected service-specific environment files in the production stack directory.
MONITOR_APP_ENV_FILE=./monitor.env
MONITOR_WORKER_ENV_FILE=./worker.env
MONITOR_DB_ENV_FILE=./database.env

# Persistent database path under the authoritative Docker root.
MONITOR_DATABASE_PATH=/srv/docker/databases/goreecloud-monitor

# Existing approved Caddy reverse-proxy network on the target Docker host.
CADDY_NETWORK=proxy

# Approved Caddy IPv4 address on the external proxy network. Worker-only host
# mappings keep Notify and approved same-host private monitoring targets on the
# proxy network so Caddy sees MONITOR_WORKER_PROXY_IP instead of Docker's
# host-published-port hairpin gateway.
MONITOR_CADDY_GATEWAY_IP=REPLACE_WITH_APPROVED_CADDY_PROXY_IP
