# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0

# Wardveil Security operational event logging. Events are minimized and secret-free.
WARDVEIL_LOG_LEVEL=INFO

# Database: sqlite for local/test, postgres for Compose/production.
DATABASE_ENGINE=sqlite
POSTGRES_DB=goreecloud_monitor
POSTGRES_USER=goreecloud_monitor
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Monitor worker
MONITOR_MAX_CONCURRENCY=10
MONITOR_MAX_RESPONSE_BYTES=1048576
MONITOR_CHECK_RETENTION_DAYS=30
MONITOR_POLL_SECONDS=1
MONITOR_ALLOW_PUBLIC_TARGETS=true
# Private/reserved destinations must be explicitly listed. Add only required GoreeCloud CIDRs.
MONITOR_ALLOWED_NETWORKS=127.0.0.0/8,::1/128

# Read-only GoreeCloud Manager integration. Leave blank to disable.
MANAGER_API_TOKEN=

# ntfy transition publishing. All three values are required when enabled.
# NTFY_TOKEN is the protected token for Monitor's dedicated write-only publisher identity.
NTFY_BASE_URL=
NTFY_TOPIC=
NTFY_TOKEN=
