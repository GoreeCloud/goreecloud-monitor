# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0

# Wardveil Security and minimized operational logging.
WARDVEIL_LOG_LEVEL=INFO
MONITOR_ACCESS_LOG_LEVEL=INFO

# Database: sqlite for local/test, postgres for Compose/production.
DATABASE_ENGINE=sqlite
POSTGRES_DB=goreecloud_monitor
POSTGRES_USER=goreecloud_monitor
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Monitor worker
MONITOR_MAX_CONCURRENCY=10
MONITOR_MAX_RESPONSE_BYTES=1048576
MONITOR_CHECK_RETENTION_DAYS=30
MONITOR_POLL_SECONDS=1
MONITOR_ALLOW_PUBLIC_TARGETS=true
MONITOR_ALLOWED_NETWORKS=127.0.0.0/8,::1/128
# Temporary migration-only compatibility. Production target preflight requires false.
MONITOR_ALLOW_LEGACY_PATH_HEARTBEATS=false

# Read-only GoreeCloud Manager integration. Leave blank to disable.
MANAGER_API_TOKEN=


# GoreeCloud Notify transition publishing. Disabled by default for local development.
# Target-environment production acceptance requires it to be enabled with both protected values and an HTTPS base URL.
MONITOR_NOTIFY_ENABLED=false
GOREECLOUD_NOTIFY_BASE_URL=
GOREECLOUD_NOTIFY_TOKEN=
MONITOR_NOTIFY_MAX_ATTEMPTS=3
MONITOR_NOTIFY_RETRY_BACKOFF_SECONDS=0.25
MONITOR_NOTIFY_TIMEOUT_SECONDS=10
MONITOR_NOTIFICATION_OUTBOX_RETENTION_DAYS=30
